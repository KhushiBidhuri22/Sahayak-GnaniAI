# Copy this file to ".env" (same folder) and fill in. Leave blank to run in demo mode.

# Gnani voice API key (Prisma speech-to-text + Timbre text-to-speech).
# Create it at https://app.gnani.ai/voice/ -> API keys, using your hackathon account.
GNANI_VOICE_API_KEY=

# Optional tweaks (these are the defaults). Voices depend on the TTS model, see docs.gnani.ai
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_STT_MODEL=prisma-v3.0
PORT=3000
